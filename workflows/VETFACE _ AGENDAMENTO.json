      "parameters": {
        "jsCode": "// Pega os itens que acabaram de chegar do nó anterior (Supabase)\nconst items = $input.all();\n\n// Se não encontrou nenhuma linha ou veio vazio\nif (!items || items.length === 0 || !items[0].json || !items[0].json.id) {\n  return [{ json: { encontrado: false } }];\n}\n\n// Pega o agendamento mais recente/válido retornado\nconst item = items[0].json;\n\nreturn [{\n  json: {\n    encontrado: true,\n    evento: {\n      id: item.id,\n      google_event_id: item.google_event_id,\n      start_time: item.start_time,\n      nomePet: item.nome_pet,\n      nomeTutor: item.nome_tutor,\n      tipoPet: item.tipo_pet\n    }\n  }\n}];"
      },
