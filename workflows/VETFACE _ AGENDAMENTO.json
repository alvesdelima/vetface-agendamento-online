    {
      "parameters": {
        "jsCode": "// Grade diária de atendimento\nconst gradeHorarios = [\"09:00\", \"10:00\", \"11:00\", \"14:00\", \"15:00\", \"16:00\", \"17:00\"];\n\n// Eventos que vieram do Google Calendar\nconst eventos = $input.all().map(i => i.json);\n\n// Mapeia eventos ocupados: { \"YYYY-MM-DD\": [\"09:00\", \"14:00\"] }\nconst ocupados = {};\nfor (const ev of eventos) {\n  if (ev.start && ev.start.dateTime) {\n    const dataObj = new Date(ev.start.dateTime);\n    const dataStr = dataObj.toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' }); // YYYY-MM-DD\n    const horaStr = dataObj.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' });\n    \n    if (!ocupados[dataStr]) ocupados[dataStr] = [];\n    ocupados[dataStr].push(horaStr);\n  }\n}\n\n// Gera a matriz dos próximos 15 dias\nconst disponibilidade = {};\nconst agora = new Date();\n\nfor (let i = 0; i < 15; i++) {\n  const dia = new Date();\n  dia.setDate(agora.getDate() + i);\n  \n  // Ignora sábado (6) e domingo (0)\n  const diaSemana = dia.getDay();\n  if (diaSemana === 0 || diaSemana === 6) continue;\n\n  const diaStr = dia.toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });\n  const ocupadosNoDia = ocupados[diaStr] || [];\n\n  // Filtra apenas o que está livre\n  const livres = gradeHorarios.filter(h => !ocupadosNoDia.includes(h));\n\n  // Só adiciona se houver pelo menos 1 horário livre\n  if (livres.length > 0) {\n    disponibilidade[diaStr] = livres;\n  }\n}\n\nreturn [{ json: { agenda: disponibilidade } }];;"
      },
