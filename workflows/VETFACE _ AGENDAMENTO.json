    {
      "parameters": {
        "jsCode": "// Valida o horário pedido e confere se ele continua livre no Google Calendar\nconst TZ = 'America/Sao_Paulo';\nconst HORAS_VALIDAS = [14, 15, 16];\nconst ANTECEDENCIA_HORAS = 48;\n\nconst body = $('Webhook Criar Evento').first().json.body || {};\nconst inicio = DateTime.fromISO(String(body.start_time || '')).setZone(TZ);\n\nlet motivo = null;\n\nif (!inicio.isValid) {\n  motivo = 'Horário inválido.';\n} else if (inicio.weekday >= 6 || !HORAS_VALIDAS.includes(inicio.hour) || inicio.minute !== 0) {\n  motivo = 'Horário fora do expediente de atendimento.';\n} else if (inicio < DateTime.now().plus({ hours: ANTECEDENCIA_HORAS })) {\n  motivo = `Os agendamentos exigem ${ANTECEDENCIA_HORAS} horas de antecedência.`;\n} else {\n  const fim = inicio.plus({ hours: 1 });\n  const conflito = $input.all()\n    .map(item => item.json)\n    .filter(e => e && e.start && e.status !== 'cancelled' && e.transparency !== 'transparent')\n    .some(e => {\n      const ini = e.start.dateTime\n        ? DateTime.fromISO(e.start.dateTime)\n        : DateTime.fromISO(e.start.date, { zone: TZ }).startOf('day');\n      const fimEvento = e.end?.dateTime\n        ? DateTime.fromISO(e.end.dateTime)\n        : e.end?.date\n          ? DateTime.fromISO(e.end.date, { zone: TZ }).startOf('day')\n          : ini.plus({ hours: 1 });\n      return ini < fim && fimEvento > inicio;\n    });\n\n  if (conflito) motivo = 'Este horário acabou de ser reservado. Por favor, escolha outro.';\n}\n\n// pairedItem mantém o vínculo com o webhook para os nós seguintes usarem .item\nreturn [{ json: { livre: motivo === null, motivo, body }, pairedItem: { item: 0 } }];"
      },
