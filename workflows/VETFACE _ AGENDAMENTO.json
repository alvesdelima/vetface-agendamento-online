    {
      "parameters": {
        "jsCode": "// Pega os itens que acabaram de chegar do nó anterior (Supabase)\nconst items = $input.all()\n  .map(item => item.json)\n  .filter(row => row && row.id && row.start_time);\n\n// Se não encontrou nenhuma linha ou veio vazio\nif (items.length === 0) {\n  return [{ json: { encontrado: false } }];\n}\n\n// Ordena pela data e pega a próxima consulta (a mais próxima de hoje)\nitems.sort((a, b) => new Date(a.start_time) - new Date(b.start_time));\nconst item = items[0];\n\nreturn [{\n  json: {\n    encontrado: true,\n    evento: {\n      id: item.id,\n      google_event_id: item.google_event_id,\n      start_time: item.start_time,\n      nomePet: item.nome_pet,\n      nomeTutor: item.nome_tutor,\n      tipoPet: item.tipo_pet\n    }\n  }\n}];"
      },
