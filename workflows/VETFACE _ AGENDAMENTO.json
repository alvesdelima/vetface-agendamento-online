    {
      "parameters": {
        "jsCode": "// Obtém os dados do nó do Supabase (Busca no BD) e do Google Calendar (Get an event1)\nconst itemSupa = $('Busca no BD').first()?.json;\nconst itemGcal = $('Get an event1').first()?.json;\n\n// Se não encontrou no Supabase\nif (!itemSupa || !itemSupa.id) {\n  return [{ json: { encontrado: false } }];\n}\n\nreturn [{\n  json: {\n    encontrado: true,\n    evento: {\n      id: itemSupa.id,\n      google_event_id: itemSupa.google_event_id,\n      start_time: itemGcal?.start?.dateTime || itemSupa.start_time,\n      nomePet: itemSupa.nome_pet,\n      nomeTutor: itemSupa.nome_tutor,\n      tipoPet: itemSupa.tipo_pet\n    }\n  }\n}];"
      },
