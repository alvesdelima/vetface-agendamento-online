    {
      "parameters": {
        "jsCode": "// 1. Obtém os eventos retornados pelo nó do Google Calendar\n//    (ignora o item vazio de quando não há eventos, cancelados e eventos marcados como \"Livre\")\nconst eventosOcupados = $('Buscar Eventos Existentes').all()\n  .map(item => item.json)\n  .filter(e => e && e.start && e.status !== 'cancelled' && e.transparency !== 'transparent');\n\n// 2. Regras de Atendimento da Clínica (sempre no fuso de São Paulo)\nconst TZ = 'America/Sao_Paulo';\nconst DIAS_A_FRENTE = 14;\n// Consultas de 1h começando às 14:00, 15:00 e 16:00 (atendimento das 14h às 17h)\nconst HORARIOS_DIA = ['14:00', '15:00', '16:00'];\nconst DURACAO_MINUTOS = 60;\n\n// 3. Converte os eventos em intervalos ocupados [início, fim) em milissegundos\n//    Eventos de dia inteiro bloqueiam o dia todo.\nconst intervalosOcupados = eventosOcupados.map(e => {\n  if (e.start.dateTime) {\n    const ini = DateTime.fromISO(e.start.dateTime);\n    const fim = e.end?.dateTime ? DateTime.fromISO(e.end.dateTime) : ini.plus({ minutes: DURACAO_MINUTOS });\n    return [ini.toMillis(), fim.toMillis()];\n  }\n  const ini = DateTime.fromISO(e.start.date, { zone: TZ }).startOf('day');\n  const fim = e.end?.date ? DateTime.fromISO(e.end.date, { zone: TZ }).startOf('day') : ini.plus({ days: 1 });\n  return [ini.toMillis(), fim.toMillis()];\n});\n\nconst conflita = (ini, fim) =>\n  intervalosOcupados.some(([a, b]) => a < fim.toMillis() && b > ini.toMillis());\n\n// 4. Gera os dias de atendimento (seg a sex) e preenche os horários livres\nconst agora = DateTime.now().setZone(TZ);\nconst agenda = {};\n\nfor (let i = 0; i <= DIAS_A_FRENTE; i++) {\n  const dia = agora.plus({ days: i }).startOf('day');\n\n  // Luxon: 1 = segunda ... 6 = sábado, 7 = domingo\n  if (dia.weekday >= 6) continue;\n\n  const chaveDia = dia.toFormat('yyyy-MM-dd');\n\n  const slotsLivres = HORARIOS_DIA.filter(hora => {\n    const [h, m] = hora.split(':').map(Number);\n    const inicio = dia.set({ hour: h, minute: m, second: 0, millisecond: 0 });\n    const fim = inicio.plus({ minutes: DURACAO_MINUTOS });\n    if (inicio <= agora) return false; // não exibe horários do passado\n    return !conflita(inicio, fim);\n  });\n\n  if (slotsLivres.length > 0) {\n    agenda[chaveDia] = slotsLivres;\n  }\n}\n\n// 5. Retorna a agenda filtrada\nreturn [{ json: { agenda } }];"
      },
