    {
      "parameters": {
        "jsCode": "// 1. Obtém os itens retornados pelo nó do Google Calendar\nconst items = $('Buscar Eventos Existentes').all();\n\n// 2. Trata retorno vazio (quando não há nenhum evento marcado na agenda)\nconst eventosOcupados = (items.length === 1 && (!items[0].json || Object.keys(items[0].json).length === 0 || !items[0].json.start))\n  ? []\n  : items.map(item => item.json);\n\n// 3. Regras de Atendimento da Clínica\nconst DIAS_A_FRENTE = 14;\n// Apenas horários das 14:00 às 17:00\nconst HORARIOS_DIA = ['14:00', '15:00', '16:00', '17:00'];\nconst agenda = {};\n\n// 4. Mapeia os horários já ocupados no Google Calendar\nconst horariosBloqueados = new Set();\n\neventosOcupados.forEach(evento => {\n  const startStr = evento.start?.dateTime || evento.start?.date;\n  if (startStr) {\n    const dataHora = new Date(startStr);\n    const dataFormatada = dataHora.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo', year: 'numeric', month: '2-digit', day: '2-digit' }).split('/').reverse().join('-');\n    const horaFormatada = dataHora.toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n    \n    horariosBloqueados.add(`${dataFormatada} ${horaFormatada}`);\n  }\n});\n\n// 5. Gera os dias de atendimento e preenche os horários livres\nconst hoje = new Date();\n\nfor (let i = 0; i <= DIAS_A_FRENTE; i++) {\n  const dataAlvo = new Date(hoje);\n  dataAlvo.setDate(hoje.getDate() + i);\n\n  // 0 = Domingo, 6 = Sábado\n  const diaSemana = dataAlvo.getDay();\n  if (diaSemana === 0 || diaSemana === 6) {\n    continue; // Bloqueia Sábados e Domingos\n  }\n\n  const ano = dataAlvo.getFullYear();\n  const mes = String(dataAlvo.getMonth() + 1).padStart(2, '0');\n  const dia = String(dataAlvo.getDate()).padStart(2, '0');\n  const chaveDia = `${ano}-${mes}-${dia}`;\n\n  // Filtra apenas os horários livres dentro da janela 14h - 17h\n  const slotsLivres = HORARIOS_DIA.filter(hora => {\n    // Se for o dia de hoje, não exibe horários do passado\n    if (i === 0) {\n      const [h, m] = hora.split(':').map(Number);\n      const agora = new Date();\n      const horaSlot = new Date(dataAlvo);\n      horaSlot.setHours(h, m, 0, 0);\n      if (horaSlot <= agora) return false;\n    }\n\n    return !horariosBloqueados.has(`${chaveDia} ${hora}`);\n  });\n\n  if (slotsLivres.length > 0) {\n    agenda[chaveDia] = slotsLivres;\n  }\n}\n\n// 6. Retorna a agenda filtrada\nreturn [{\n  json: {\n    agenda: agenda\n  }\n}];"
      },
